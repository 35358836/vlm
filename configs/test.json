{
    "vlm":{
        "vision_encoder":{
            "name": "neurovfm",
            "args":{
                "model_config_path": "/hpc/jtia475/model_weights/neurovfm/config.json",
                "model_weight_path": "/hpc/jtia475/model_weights/neurovfm/pytorch_model.bin"
            }
        },
        "text_decoder":{
            "name": "Qwen3-0.6B",
            "args":{
                "model_dir": "/hpc/jtia475/model_weights/Qwen3-0.6B",
                "image_token": "<|image_pad|>",
                "system_prompt": "You are a helpful medical imaging assistant. Think step by step before answering.",
                "lora_config": {
                    "r": 16,
                    "lora_alpha":32,
                    "target_modules":[
                        "q_proj", "k_proj", "v_proj", "o_proj",
                        "gate_proj", "up_proj", "down_proj"
                    ],
                    "lora_dropout":0.05,
                    "bias":"none",
                    "task_type":"CAUSAL_LM"
                }
            }
        }
    },
    "training":{
        "data_path": "/hpc/jtia475/datasets/mytest/data_set.json",
        "output_dir": "/hpc/jtia475/vlm_train/outputs/test",
        "target_shape": [48, 224, 224],
        "num_epochs": 100,
        "patience": 10,
        "batch_size": 2,
        "lr": 0.0002,
        "weight_decay": 0.01,
        "warmup_ratio": 0.03,
        "grad_clip": 1.0,
        "amp": true,
        "val_ratio": 0.1,
        "num_workers": 4,
        "seed": 42,
        "log_steps": 10,
        "num_val_generate": 2,
        "resume": false
    }
}